# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment - never commit real secrets
.env
.env.local
.env.*.local
!.env.example

# Vercel CLI link state (project id only, but keep the repo clean)
.vercel/
# Scratch directory used by the Vercel deploy workflow (temp scripts + login log)
.vercel-tmp/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage
coverage/
.nyc_output/
.vitest-report.json

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Databases / dumps
*.mongo
data/db/
dump/
.vercel
.env*
# `.env*` (appended by the Vercel CLI) would otherwise re-ignore the template
# file, because the last matching pattern wins. Re-assert the exception after it.
!.env.example
