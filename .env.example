# ─────────────────────────────────────────────────────────────
# HCM Lite — environment template. Copy to .env and fill in.
# NEVER commit real secrets. All values below are placeholders.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# MongoDB. Local: mongodb://127.0.0.1:27017/hcm_lite
# Atlas:   mongodb+srv://<user>:<password>@<cluster>/hcm_lite
# Always name the database in the path — a URI ending in "/" silently
# falls back to the driver's default "test" database.
# If the Atlas seed fails with `querySrv ECONNREFUSED`, Node's DNS SRV
# lookup is failing locally even though the cluster is fine. Use the
# non-SRV form instead and list the shard hosts the SRV record returns:
#   mongodb://<user>:<password>@host1:27017,host2:27017,host3:27017/hcm_lite?tls=true&authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/hcm_lite

# Session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Browser origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:5173

# First-run bootstrap. Leave ADMIN_PASSWORD empty to use the
# one-time POST /api/v1/setup endpoint instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI assistant. `rules` (default) answers from live database facts;
# `openai` only rephrases the same answer through a chat model.
AI_PROVIDER=rules
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ── Reserved ──
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# Production: the API also serves the built frontend so the UI and /api/v1
# share one origin (the session cookie stays first-party). Leave this unset to
# let the process locate web/dist automatically, or set it when the layout is
# unusual — a serverless bundle, for example.
# WEB_ROOT=web/dist
